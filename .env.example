# Modo del grafo: live (LLM + RAG) | fake (nodos dummy, sin credenciales).
# docker compose lee este valor; default live.
SPEC_REFINERY_GRAPH=live

# gemini (Vertex) | openrouter
LLM_PROVIDER=gemini
# Timeout por request (segundos) y reintentos acotados del SDK para cada
# llamada de modelo (intake y writer): un proveedor colgado o throttled falla
# rápido en lugar de dejar el turno abierto.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
GOOGLE_GENAI_USE_VERTEXAI=true
# Ruta al JSON de ADC, relativa a la raíz del repo: docker compose monta ese
# archivo read-only en /secrets/adc.json dentro del contenedor.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
OPENROUTER_API_KEY=
VECTOR_BACKEND=chroma
CHECKPOINT_PATH=checkpoints.sqlite
# Phoenix tracing (default host-side). En docker-compose el override usa http://phoenix:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6010/v1/traces
